# Plantilla de variables de entorno del backend.
# COPIA este archivo como ".env.local" (mismo directorio) y coloca tus
# credenciales reales. ".env.local" es ignorado por git.
#
# El backend lo carga automaticamente al iniciar (spring.config.import).

DB_USER=root
DB_PASSWORD=

# ---- Búsqueda por voz (DeepGram) ----
# Crea tu API key en https://console.deepgram.com y pégala aquí (en tu
# archivo .env.local, no en este). Sin key, POST /api/voz/transcribir
# responde 502 indicando que falta configuración.
DEEPGRAM_API_KEY=
# Opcionales (valores por defecto si se omiten):
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_LANGUAGE=es-419
